{
  "name": "circlepay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter ./frontend dev",
    "dev:api": "pnpm --filter ./backend start:dev",
    "build": "pnpm --filter ./packages/shared build && pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "build:shared": "pnpm --filter ./packages/shared build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
