# backend/.env — SECRETS. Never commit. Never prefix with NEXT_PUBLIC_.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Public app URL used in invite SMS join links (E3)
APP_BASE_URL=http://localhost:3000

# Database
# Local dev via Docker (see root docker-compose.yml — host port 5433):
DATABASE_URL=postgresql://circlepay:circlepay@localhost:5433/circlepay
# Production (Neon): postgresql://user:pass@host/db?sslmode=require

# Auth / sessions (E1) — ephemeral auth state (OTP, rate-limit, lockout, sessions) lives in Redis
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REG_TOKEN_TTL=10m
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_MAX=3
OTP_RATE_WINDOW_SECONDS=600
PIN_MAX_ATTEMPTS=5
PIN_LOCK_SECONDS=900

# Moolre (see moolre-integration skill)
MOOLRE_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=your-moolre-username
MOOLRE_API_KEY=
MOOLRE_PUBKEY=
MOOLRE_VASKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=change-me-to-a-long-random-string
MOOLRE_SMS_SENDER_ID=CirclePay

# Jobs / locks / queue (concurrency — see references/operations.md)
# Local dev via Docker (see root docker-compose.yml — host port 6380):
REDIS_URL=redis://localhost:6380
WORKER=false   # true on the one instance that runs scheduled jobs (if not using locks/queue)

# Observability
SENTRY_DSN=

# AI Advisor (deferred — uncomment when wiring Claude)
# ANTHROPIC_API_KEY=
