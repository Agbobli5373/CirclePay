# backend/.env — SECRETS. Never commit. Never prefix with NEXT_PUBLIC_.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000   # public app URL used in invite SMS join links

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth / sessions
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Susu economics & lifecycle
PLATFORM_FEE_FLAT=0    # pesewas; fee = FLAT + amount*BPS/10000
PLATFORM_FEE_BPS=0
GRACE_HOURS=48         # hours after due date before an overdue member defaults + is locked

# Moolre (see moolre-integration skill)
MOOLRE_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=your-moolre-username
MOOLRE_API_KEY=
MOOLRE_PUBKEY=
MOOLRE_VASKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=change-me-to-a-long-random-string
MOOLRE_SMS_SENDER_ID=CirclePay
MOOLRE_SUBLIST_ID=               # beneficiary sublist for disbursements/payouts
MOOLRE_TIMEOUT_MS=15000          # per-request HTTP timeout so a payment call never hangs the worker
# DEV ONLY — simulate Moolre locally (collect/transfer/SMS succeed, self-settle via webhook).
# Ignored when NODE_ENV=production. Lets you run the full money path without live Moolre access.
MOOLRE_MOCK_ENABLED=false        # true = use the in-process mock client
MOOLRE_MOCK_SETTLE_MS=2500       # delay before the simulated settlement webhook fires
# MOOLRE_MOCK_CALLBACK_BASE=http://127.0.0.1:4000/api   # override if API isn't on $PORT

# USSD channel (E10) — gateway POSTs each keypress to POST /api/ussd/<USSD_GATEWAY_SECRET>
USSD_GATEWAY_SECRET=change-me-to-a-long-random-string
USSD_SESSION_TTL_SECONDS=120     # idle USSD session state TTL in Redis (carriers close ~120s)

# Jobs / locks / queue (concurrency — see references/operations.md)
REDIS_URL=redis://localhost:6380   # REQUIRED: ephemeral auth state (OTP, lockout, sessions)
WORKER=false   # true on the one instance that runs scheduled jobs (if not using locks/queue)

# Observability
SENTRY_DSN=

# AI Advisor (deferred — uncomment when wiring Claude)
# ANTHROPIC_API_KEY=
