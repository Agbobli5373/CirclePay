# Moolre credentials — SERVER-SIDE ONLY. Do not prefix with NEXT_PUBLIC_.
# Sandbox base URL (no keys needed); switch to https://api.moolre.com for live.
MOOLRE_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=your-moolre-username
# Private API key — required in LIVE only (leave blank in sandbox).
MOOLRE_API_KEY=
# Public key (payment links / validation) and VAS key (SMS/WhatsApp) — optional for core flows.
MOOLRE_PUBKEY=
MOOLRE_VASKEY=
# Your Moolre account/wallet number (sent in every request).
MOOLRE_ACCOUNT_NUMBER=100000157291
# Your own secret embedded in the webhook URL path to guard the callback endpoint.
MOOLRE_WEBHOOK_SECRET=change-me-to-a-long-random-string
